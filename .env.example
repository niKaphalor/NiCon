# Copy to .env (gitignored) and fill in before running docker compose up.

# Same database the Cloud API (webspace/config.local.php) uses.
NICON_DB_DSN=nicon:<db-password>@tcp(<host>:3306)/nicon?parseTime=true

# Must match the Cloud API's config.local.php encryption_key_base64 exactly
# — both read/write the same servers.password_enc column.
NICON_ENCRYPTION_KEY=<same key as the Cloud API>

# A hostname that resolves to this server's public IP, for Caddy's
# automatic TLS certificate. No domain? Use the free sslip.io trick:
# relay.<this-server's-public-IP>.sslip.io (dots in the IP are fine, it
# just resolves to that IP). Requires ports 80 and 443 reachable from the
# internet (see README).
RELAY_DOMAIN=relay.203.0.113.10.sslip.io
